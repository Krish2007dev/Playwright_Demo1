{
  "name": "vwo-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript automation framework for the VWO login portal",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:invalid": "playwright test tests/vwoInvalidLogin.spec.ts",
    "test:valid": "playwright test tests/vwoValidLogin.spec.ts",
    "report": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "allure-playwright": "^3.4.2",
    "typescript": "^5.9.3"
  }
}
